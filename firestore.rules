rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // 메모: 본인만 읽고 쓰기 + 크기 제한 (Firestore 문서 한도 1MB 이내)
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.html is string
        && request.resource.data.html.size() < 900000;
    }

    // 지운 내용 기록: 본인만
    match /users/{uid}/deletions/{id} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.noteId is string;
    }

    // 사용량 기록 (지운 내용 기록이 차지하는 크기)
    match /users/{uid}/meta/{doc} {
      allow read, write: if isOwner(uid);
    }
  }
}
